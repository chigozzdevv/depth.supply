      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    }
  },
  "scripts": {
    "build": "node ../../scripts/build-package.mjs maker-sdk",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@anchor-lang/core": "1.0.2",
    "@arcium-hq/client": "0.13.2",
    "@depthhq/bindings": "workspace:*",
    "@depthhq/sdk": "workspace:*",
    "@solana/web3.js": "1.99.0",
    "buffer": "6.0.3",
    "@nktkas/hyperliquid": "0.33.3",
    "viem": "2.38.0"
  }
}
