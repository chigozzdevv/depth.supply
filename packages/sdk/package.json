{
  "name": "@depthhq/sdk",
  "version": "0.1.3",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./data": {
      "types": "./dist/catalog/data.d.ts",
      "default": "./dist/catalog/data.js"
    },
    "./views": {
      "types": "./dist/view/view.d.ts",
      "default": "./dist/view/view.js"
    },
    "./recovery": {
      "types": "./dist/recovery/recovery.d.ts",
      "default": "./dist/recovery/recovery.js"
    },
    "./funding": {
      "types": "./dist/account/funding.d.ts",
      "default": "./dist/account/funding.js"
    },
    "./operator": {
      "types": "./dist/operator.d.ts",
      "default": "./dist/operator.js"
    }
  },
  "scripts": {
    "build": "node ../../scripts/build-package.mjs sdk",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@anchor-lang/core": "1.0.2",
    "@arcium-hq/client": "0.13.2",
    "@depthhq/bindings": "workspace:*",
    "@depthhq/schema": "workspace:*",
    "@noble/ciphers": "1.3.0",
    "@noble/ed25519": "1.7.5",
    "@noble/hashes": "1.8.0",
    "@solana/web3.js": "1.99.0",
    "buffer": "6.0.3"
  },
  "devDependencies": {
    "fake-indexeddb": "6.2.4"
  }
}
