{
  "name": "@depth/contracts",
  "private": true,
  "scripts": {
    "build": "node --env-file-if-exists=../.env.local scripts/build.mjs",
    "deploy:devnet": "node --env-file-if-exists=../.env.local scripts/deploy.mjs",
    "init:defs": "node --env-file-if-exists=../.env.local scripts/defs.mjs",
    "init:protocol": "node --env-file-if-exists=../.env.local scripts/protocol.mjs",
    "init:market": "bun --env-file=../.env.local ../packages/sdk/scripts/market.ts",
    "test": "node --test scripts/circuits.test.mjs && node scripts/test.mjs",
    "typecheck": "tsc --noEmit",
    "verify:circuits": "node --env-file-if-exists=../.env.local scripts/verify-circuits.mjs",
    "upload:circuits": "node --env-file-if-exists=../.env.local scripts/upload-circuits.mjs",
    "format": "prettier \"tests/**/*.ts\" --write",
    "format:check": "prettier \"tests/**/*.ts\" --check"
  },
  "dependencies": {
    "@anchor-lang/core": "1.0.2",
    "@arcium-hq/client": "0.13.2",
    "@solana/web3.js": "1.99.0"
  },
  "devDependencies": {
    "@solana/spl-token": "0.4.15",
    "@types/bn.js": "^5.1.0",
    "@types/chai": "^4.3.0",
    "@types/mocha": "^9.0.0",
    "@types/node": "26.6.2",
    "chai": "^4.3.4",
    "mocha": "^9.0.3",
    "prettier": "^2.6.2",
    "ts-mocha": "^10.0.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3"
  }
}
