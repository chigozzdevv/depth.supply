{
  "compilerOptions": {
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "baseUrl": ".",
    "paths": {
      "@/workspace": ["paths"],
      "@/devnet/*": ["devnet/*"],
      "@/server/*": ["../server/src/*"],
      "@/*": ["../server/src/*"]
    },
    "types": ["node"]
  },
  "include": ["devnet/**/*.ts"]
}
