{
  "compilerOptions": {
    "types": ["mocha", "chai", "node"],
    "typeRoots": ["./node_modules/@types"],
    "lib": ["es2020"],
    "module": "commonjs",
    "target": "es2020",
    "esModuleInterop": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"],
      "@/circuits": ["../packages/bindings/dist/index.js"],
      "@/sdk": ["../packages/sdk/dist/index.js"],
      "@/maker": ["../packages/maker-sdk/dist/index.js"],
      "@/operator": ["../packages/sdk/dist/operator.js"]
    },
    "skipLibCheck": true
  },
  "exclude": ["build", "target", "node_modules"]
}
